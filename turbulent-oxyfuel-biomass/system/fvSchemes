FoamFile
{
    version     2.0;
    format      binary;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// ************************************************************************* //
ddtSchemes
{
    default         backward;
}

gradSchemes
{
    default         cellLimited Gauss linear 1;
    grad(p)         Gauss linear;    
}

divSchemes
{
    default           none;
    div(phi,U)        Gauss linear;
    div(phi,K)        Gauss linear;
    div(phi,k)        Gauss limitedLinear 1;
    div(phi,epsilon)  Gauss limitedLinear 1;
    div(phi,Z)        Gauss limitedLinear01 0.5; 
    div(phi,Y)        Gauss limitedLinear01 0.5;
    div(phi,YY)        Gauss limitedLinear01 0.5;
    div(phi,Z1)       Gauss limitedLinear01 0.5; 
    div(phi,Z2)       Gauss limitedLinear01 0.5; 
    div(phi,Z3)       Gauss limitedLinear01 0.5; 
    div(phi,yc)       Gauss limitedLinear 0.5;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
    div(phi,Yi_h)     Gauss limitedLinear 1;
    div(phi,ha)     Gauss limitedLinear 0.5;
    div(Ji,Ii_h)    Gauss upwind;

}

laplacianSchemes
{
 default         Gauss linear limited 0.5;
}

interpolationSchemes
{
  default                 linear;
}

snGradSchemes
{
  default         limited corrected 0.5;

}
