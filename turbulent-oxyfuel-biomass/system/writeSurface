writeSurface
    {
        type            surfaces;
        libs            ("libsampling.so");
        writeControl    adjustableRunTime;
        writeInterval   1e-4;

        interpolationScheme cellPoint;

        surfaceFormat vtk;

        // Fields to be sampled
        fields
        (
            U
            Z
            Y
            YY
            T
            OH
            rho
            p
            ha 
            Zvar
            yc
            Z1
            Z2
            Z3
            SZ1
            SZ3
            Syc 
            omega_yc 
        );

        surfaces
        (
            slice_y
            {
                type            cuttingPlane;
                planeType       pointAndNormal;
                pointAndNormalDict
                {
                point (0 0 0);
                normal    (0 1 0);
                }
            }
            slice_x
            {
                type            cuttingPlane;
                planeType       pointAndNormal;
                pointAndNormalDict
                {
                point (0 0 0);
                normal    (1 0 0);
                }
            }
        );
    }
