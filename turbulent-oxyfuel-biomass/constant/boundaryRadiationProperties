FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      boundaryRadiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

".*"
{
    type            opaqueDiffusive;
    wallAbsorptionEmissionModel
    {
        type multiBandAbsorption;   //Emission;
        emissivity      (0.7 0.7 0.7 0.7 0.7);
        absorptivity    (1 1 1 1 1);
     }
}

