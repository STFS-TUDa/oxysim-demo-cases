#!/bin/bash
# Template Slurm script for laminar-coal. Copy it to submit_local.slm
# (untracked), adapt the entries marked "adapt", and submit with:
#   sbatch submit_local.slm
#SBATCH --job-name=laminar-coal
#SBATCH --output=%x.%A.out
#SBATCH --error=%x.%A.err
#SBATCH --account=your-project        # adapt
#SBATCH --partition=your-partition    # adapt
#SBATCH --nodes=1
#SBATCH --exclusive
#SBATCH --ntasks-per-node=20          # must match numberOfSubdomains in system/decomposeParDict
#SBATCH --time=24:00:00               # adapt
##SBATCH --mail-user=your.email@example.org
##SBATCH --mail-type=ALL

# Your local copy of oxysim-129's scripts/source_template.sh
source /path/to/oxysim-129/scripts/source_local.sh    # adapt

mpirun -np 20 flameletCloudFoam -parallel
