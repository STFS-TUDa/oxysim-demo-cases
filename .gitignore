# --- Solver run artifacts (both cases) -- regenerated by running the case ---
**/processor*/
**/postProcessing/
**/dynamicCode/
**/*.out
**/*.err
**/core.*
**/log.*

# --- Slurm scripts: copy *_template.slm to *_local.slm and adapt (untracked) ---
**/*_local.slm

# --- ParaView case marker -- create locally: touch case.foam ---
*.foam

# --- Editor / OS cruft ---
*.swp
*.swo
*~

# --- laminar-coal: mesh is regenerated by blockMesh (see Allrun) ---
/laminar-coal/constant/polyMesh/

# --- Time directories: only the committed first timestep of each case is tracked ---
/turbulent-oxyfuel-biomass/[0-9]*
!/turbulent-oxyfuel-biomass/6.87
/laminar-coal/[0-9]*
!/laminar-coal/0

# --- visualization: local virtual environment and notebook checkpoints ---
/visualization/.venv/
**/.ipynb_checkpoints/
**/__pycache__/

# --- turbulent-oxyfuel-biomass: FLUTs are hosted on TUdatalib (~29GB combined) ---
# Supply them locally to actually run the case; see its README.
/turbulent-oxyfuel-biomass/FLUT.h5
/turbulent-oxyfuel-biomass/FLUT_BC.h5
